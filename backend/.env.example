# Backend Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agriconnect

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins for production, or * for development
CORS_ORIGIN=*

# Nokia Network-as-Code (from networkascode.nokia.io dashboard)
NAC_RAPID_API_KEY=your-application-or-rapidapi-key-from-nac-dashboard
NAC_PROJECT_ID=your-project-id-from-nac-dashboard

# Optional: we may later use Nokia sandbox/dev RapidAPI gateways if later available.
# For regular simulator test devices, please leave this false unless we shift Nokia support
NAC_USE_SANDBOX=false

# API gateway.
# NAC_SIM_SWAP_BASE_URL=https://sim-swap.p-eu.rapidapi.com/sim-swap/sim-swap/v0
# NAC_SIM_SWAP_RAPID_API_HOST=sim-swap.nokia.rapidapi.com
# NAC_LOCATION_VERIFICATION_BASE_URL=https://location-verification.p-eu.rapidapi.com
# NAC_LOCATION_VERIFICATION_RAPID_API_HOST=location-verification.nokia.rapidapi.com
# NAC_DEVICE_STATUS_BASE_URL=https://device-status.p-eu.rapidapi.com
# NAC_DEVICE_STATUS_RAPID_API_HOST=device-status.nokia.rapidapi.com
# NAC_KYC_MATCH_BASE_URL=https://kyc-match.p-eu.rapidapi.com/kyc-match/v0
# NAC_KYC_MATCH_RAPID_API_HOST=kyc-match.nokia.rapidapi.com
# NAC_NUMBER_VERIFICATION_BASE_URL=https://number-verification-verify.p-eu.rapidapi.com/number-verification/v0
# NAC_NUMBER_VERIFICATION_RAPID_API_HOST=number-verification-verify.nokia.rapidapi.com
