# Backend Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agriconnect

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins for production, or * for development
CORS_ORIGIN=*

# Nokia Network-as-Code (from networkascode.nokia.io dashboard)
NAC_RAPID_API_KEY=your-rapidapi-key-from-nac-dashboard
NAC_PROJECT_ID=your-project-id-from-nac-dashboard
